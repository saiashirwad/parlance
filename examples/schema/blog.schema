schema Blog

enum Role { Member Admin }
enum PostStatus { Draft Published }

model User {
  id: Int @primary @auto
  email: String @unique
  role: Role @default(Member)
  createdAt: DateTime @default(now)
}

model Post {
  id: Int @primary @auto
  title: String
  status: PostStatus @default(Draft)
  views: Int @default(0)
  createdAt: DateTime @default(now)
  authorId: User
}

query userByEmail(email: String): User? =
  User |> where email == email |> first;

query publishedPosts(limit: Int): Post[] =
  Post |> where status == Published |> orderBy id desc |> limit limit |> all;

query draftCount(): Int =
  Post |> where status == Draft |> count;

insert User { email: $email, role: $role }

insert Post { title: $title, status: $status, authorId: $authorId }

update Post |> where id == $id |> set status = $status

delete Post |> where id == $id
