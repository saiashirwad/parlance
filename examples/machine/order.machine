machine Order {
  event edit
  event pay(amount: Int)
  event cancel

  initial state Cart {
    on edit -> Cart
    on pay(amount) -> Checkout
    on cancel -> Cancelled
  }

  state Checkout {
    on edit -> Checkout
    on pay(amount) -> Paid
    on cancel -> Cancelled
  }

  state Paid {
    on edit -> Paid
    on cancel -> Cancelled
  }

  final state Cancelled {}
}
