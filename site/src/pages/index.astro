---
import "../styles/site.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Try parlance in the browser: small languages with a real language server, emitted TypeScript, and runnable output." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='4' fill='%235b5bd6'/%3E%3C/svg%3E" />
    <title>parlance playground</title>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="./">parlance</a>
      <span class="brand-sub">playground</span>
      <label>
        <span class="sr-only">Language</span>
        <select id="language" class="select"></select>
      </label>
      <span class="spacer"></span>
      <span id="status" class="status" data-state="starting">starting</span>
      <button id="run-gpu" class="button" type="button" hidden>Run on WebGPU</button>
      <button id="run" class="button primary" type="button" title="Run (Ctrl/Cmd-Enter)">Run</button>
      <a class="github" href="https://github.com/saiashirwad/parlance" aria-label="parlance on GitHub" title="GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </header>

    <main id="split" class="split">
      <section class="pane" aria-label="Editor">
        <nav id="files" class="tabs" role="tablist" aria-label="Files"></nav>
        <div id="editors" class="editors"></div>
        <div class="hint">
          <kbd>F12</kbd> or <kbd>⌘-click</kbd> definition · <kbd>F2</kbd> rename · <kbd>Shift-F12</kbd> references
          · <kbd>Ctrl-Space</kbd> complete · <kbd>⌘-Enter</kbd> run
        </div>
      </section>
      <div id="divider" class="divider" role="separator" aria-orientation="vertical" aria-label="Resize" tabindex="0"></div>
      <section class="pane output-pane" aria-label="Output">
        <nav id="outputs" class="tabs" role="tablist" aria-label="Output">
          <button class="tab" role="tab" data-panel="run" aria-selected="true">Run</button>
          <button class="tab" role="tab" data-panel="emit">Emit</button>
          <button class="tab" role="tab" data-panel="ts">TypeScript</button>
          <button class="tab" role="tab" data-panel="problems">Problems <span id="problem-count" class="count" hidden></span></button>
        </nav>
        <div class="output-body">
          <div class="panel" data-panel="run"><div id="console" class="console" aria-live="polite"></div></div>
          <div class="panel" data-panel="emit" hidden>
            <div class="panel-tools">
              <label for="target">Target</label>
              <select id="target" class="select"></select>
              <span id="emit-for"></span>
            </div>
            <div id="emit-view" class="panel-view"></div>
          </div>
          <div class="panel" data-panel="ts" hidden>
            <div class="panel-tools"><span id="ts-for"></span></div>
            <div id="ts-view" class="panel-view"></div>
          </div>
          <div class="panel" data-panel="problems" hidden><ul id="problems" class="problems"></ul></div>
        </div>
      </section>
    </main>

    <script>
      import "../playground/main.ts";
    </script>
  </body>
</html>
