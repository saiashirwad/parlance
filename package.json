{
  "name": "parlance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A grammar-first toolkit for small languages that live in TypeScript and Node",
  "exports": {
    ".": "./src/language.ts",
    "./source": "./src/source.ts",
    "./diagnostic": "./src/diagnostic.ts",
    "./grammar": "./src/grammar/index.ts",
    "./check": "./src/check/index.ts",
    "./modules": "./src/modules.ts",
    "./types": "./src/types/index.ts",
    "./ts": "./src/ts/index.ts",
    "./ts/host": "./src/ts/host.ts",
    "./ts/loader": "./src/ts/loader.ts",
    "./lsp": "./src/lsp/server.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "node tools/check.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "bench": "node tools/bench.ts",
    "gen": "node src/grammar/cli.ts",
    "cli": "node src/cli.ts",
    "nvim:smoke": "nvim --headless -u NONE -l tools/nvim-smoke.lua",
    "nvim:check": "sh tools/nvim-exrc-check.sh",
    "compare:langkit": "node tools/compare-langkit.mjs"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@parlance/ts-host": "workspace:*",
    "@types/node": "^26.1.1",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "node": ">=24.2"
  },
  "bin": {
    "parlance": "./src/cli.ts"
  }
}
